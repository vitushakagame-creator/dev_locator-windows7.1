# For production, set all of these in the DigitalOcean dashboard, not in GitHub.
REQUIRE_PERSISTENT_STORAGE=1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/DATABASE?sslmode=require
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
COOKIE_SECURE=1
SITE_URL=https://your-app.ondigitalocean.app
SITE_ORIGIN=https://your-app.ondigitalocean.app
API_PUBLIC_URL=https://your-app.ondigitalocean.app
SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=your-bucket-name
SPACES_ACCESS_KEY=your-spaces-access-key
SPACES_SECRET_KEY=your-spaces-secret-key
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=https://your-app.ondigitalocean.app/auth/github/callback
